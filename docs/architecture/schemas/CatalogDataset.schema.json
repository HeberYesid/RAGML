{
  "$defs": {
    "AttributeDefinition": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value_type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "choice"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "required_for_comparison": {
          "default": false,
          "title": "Required For Comparison",
          "type": "boolean"
        },
        "choices": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "key",
        "label",
        "value_type"
      ],
      "title": "AttributeDefinition",
      "type": "object"
    },
    "AttributeValue": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "AttributeValue",
      "type": "object"
    },
    "Category": {
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "minLength": 1,
          "title": "Category Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "attribute_definitions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttributeDefinition"
          },
          "title": "Attribute Definitions",
          "type": "array"
        }
      },
      "required": [
        "category_id",
        "name"
      ],
      "title": "Category",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "store_id": {
          "minLength": 1,
          "title": "Store Id",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "category_id": {
          "minLength": 1,
          "title": "Category Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "attributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttributeValue"
          },
          "title": "Attributes",
          "type": "array"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "store_id",
        "product_id",
        "category_id",
        "name",
        "revision"
      ],
      "title": "Product",
      "type": "object"
    },
    "StoreProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "store_id": {
          "minLength": 1,
          "title": "Store Id",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "data_mode": {
          "enum": [
            "demo",
            "real"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "locale": {
          "minLength": 1,
          "title": "Locale",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "currency_decimal_places": {
          "maximum": 6,
          "minimum": 0,
          "title": "Currency Decimal Places",
          "type": "integer"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/Category"
          },
          "title": "Categories",
          "type": "array"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "human_contact": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Contact"
        }
      },
      "required": [
        "store_id",
        "display_name",
        "data_mode",
        "locale",
        "currency",
        "currency_decimal_places",
        "categories",
        "revision"
      ],
      "title": "StoreProfile",
      "type": "object"
    },
    "Variant": {
      "additionalProperties": false,
      "properties": {
        "store_id": {
          "minLength": 1,
          "title": "Store Id",
          "type": "string"
        },
        "variant_id": {
          "minLength": 1,
          "title": "Variant Id",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "attributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttributeValue"
          },
          "title": "Attributes",
          "type": "array"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "sku": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        }
      },
      "required": [
        "store_id",
        "variant_id",
        "product_id",
        "name",
        "revision"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/StoreProfile"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/Product"
      },
      "title": "Products",
      "type": "array"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/Variant"
      },
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "profile",
    "products",
    "variants"
  ],
  "title": "CatalogDataset",
  "type": "object"
}
