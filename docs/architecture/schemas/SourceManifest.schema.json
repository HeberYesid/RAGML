{
  "$defs": {
    "Chunk": {
      "additionalProperties": false,
      "properties": {
        "store_id": {
          "minLength": 1,
          "title": "Store Id",
          "type": "string"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "source_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Content Hash",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "required": [
        "store_id",
        "chunk_id",
        "source_id",
        "source_version",
        "source_content_hash",
        "content_hash",
        "text",
        "location"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "paragraph": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "table": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "store_id": {
          "minLength": 1,
          "title": "Store Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_mode": {
          "enum": [
            "demo",
            "real"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SourceScope"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "synthetic_created",
            "authorized"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "store_id",
        "source_id",
        "title",
        "version",
        "content_hash",
        "data_mode",
        "scope",
        "locator",
        "provenance"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceScope": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "store",
            "category",
            "product",
            "variant"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SourceScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "store_id": {
      "minLength": 1,
      "title": "Store Id",
      "type": "string"
    },
    "data_mode": {
      "enum": [
        "demo",
        "real"
      ],
      "title": "Data Mode",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/Chunk"
      },
      "title": "Chunks",
      "type": "array"
    }
  },
  "required": [
    "store_id",
    "data_mode",
    "revision",
    "sources",
    "chunks"
  ],
  "title": "SourceManifest",
  "type": "object"
}
