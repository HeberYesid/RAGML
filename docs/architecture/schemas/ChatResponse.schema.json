{
  "$defs": {
    "CommercialCitation": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "kind": {
          "const": "commercial",
          "default": "commercial",
          "title": "Kind",
          "type": "string"
        },
        "store_id": {
          "minLength": 1,
          "title": "Store Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "variant_id": {
          "minLength": 1,
          "title": "Variant Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "price",
            "stock"
          ],
          "title": "Field",
          "type": "string"
        },
        "source_updated_at": {
          "format": "date-time",
          "title": "Source Updated At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "store_id",
        "source_id",
        "source_version",
        "snapshot_id",
        "variant_id",
        "field",
        "source_updated_at",
        "expires_at"
      ],
      "title": "CommercialCitation",
      "type": "object"
    },
    "DocumentCitation": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "kind": {
          "const": "document",
          "default": "document",
          "title": "Kind",
          "type": "string"
        },
        "store_id": {
          "minLength": 1,
          "title": "Store Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "store_id",
        "source_id",
        "source_version",
        "chunk_id",
        "location",
        "excerpt"
      ],
      "title": "DocumentCitation",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "paragraph": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "table": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "ProductReference": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "variant_id": {
          "minLength": 1,
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "variant_id"
      ],
      "title": "ProductReference",
      "type": "object"
    },
    "SupportedClaim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "citation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Citation Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "citation_ids"
      ],
      "title": "SupportedClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "store_id": {
      "minLength": 1,
      "title": "Store Id",
      "type": "string"
    },
    "data_mode": {
      "enum": [
        "demo",
        "real"
      ],
      "title": "Data Mode",
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "clarification_required",
        "insufficient_evidence",
        "temporarily_unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "answer": {
      "minLength": 1,
      "title": "Answer",
      "type": "string"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SupportedClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "citations": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "commercial": "#/$defs/CommercialCitation",
            "document": "#/$defs/DocumentCitation"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DocumentCitation"
          },
          {
            "$ref": "#/$defs/CommercialCitation"
          }
        ]
      },
      "title": "Citations",
      "type": "array"
    },
    "products": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProductReference"
      },
      "title": "Products",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "versions": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    }
  },
  "required": [
    "request_id",
    "session_id",
    "store_id",
    "data_mode",
    "status",
    "answer",
    "versions"
  ],
  "title": "ChatResponse",
  "type": "object"
}
