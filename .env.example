# Optional local configuration. Relative paths use --project-dir (default: current directory).
RAGML_ENV=local
RAGML_DATA_MODE=demo
RAGML_CATALOG_PATH=data/sample/catalog.json
RAGML_COMMERCIAL_PATH=data/sample/commercial.json
RAGML_SOURCE_MANIFEST=data/sample/sources.json
RAGML_RUNTIME_DIR=data/runtime
RAGML_HOST=127.0.0.1
RAGML_PORT=8000
RAGML_MODEL_LOCK_PATH=config/models.lock.json
RAGML_OLLAMA_URL=http://127.0.0.1:11435
RAGML_GENERATION_MODEL=qwen3:4b-instruct-2507-q4_K_M
RAGML_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAGML_EMBEDDING_DIMENSIONS=1024
RAGML_CONTEXT_TOKENS=4096
RAGML_OUTPUT_TOKENS=256
RAGML_MODEL_TIMEOUT_SECONDS=180
RAGML_SESSION_TTL_SECONDS=1800
RAGML_MAX_MESSAGE_CHARS=4000
RAGML_RETRIEVAL_K=5
RAGML_ALLOW_REMOTE_PROVIDERS=false
